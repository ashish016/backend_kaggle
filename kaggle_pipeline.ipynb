# ## Cell 2 — register Kaggle Secrets as env vars
# Add these as Kaggle Secrets (Add-ons -> Secrets): GEMINI_API_KEY,
# PEXELS_API_KEY (or PIXABAY_API_KEY), NGROK_AUTH_TOKEN,
# YOUTUBE_CLIENT_SECRET (json text), optionally ELEVENLABS_API_KEY.
import os
from kaggle_secrets import UserSecretsClient  # type: ignore

secrets = UserSecretsClient()
os.environ["GEMINI_API_KEY"] = secrets.get_secret("GEMINI_API_KEY")
os.environ["PEXELS_API_KEY"] = secrets.get_secret("PEXELS_API_KEY")
os.environ["NGROK_AUTH_TOKEN"] = secrets.get_secret("NGROK_AUTH_TOKEN")
try:
    os.environ["ELEVENLABS_API_KEY"] = secrets.get_secret("ELEVENLABS_API_KEY")
except Exception:
    pass

# Write the YouTube client secret json out of a Kaggle secret.
import json
from pathlib import Path
secret_dir = Path("backend_kaggle/static")
secret_dir.mkdir(parents=True, exist_ok=True)
try:
    client_secret_text = secrets.get_secret("YOUTUBE_CLIENT_SECRET")
    (secret_dir / "youtube_client_secret.json").write_text(client_secret_text)
except Exception:
    pass

# ## Cell 3 — clone the repo (or upload it as a dataset)
# !git clone https://github.com/your-org/youtube-shorts-ai.git
# %cd youtube-shorts-ai/backend_kaggle

# ## Cell 4 — start the server with Ngrok
from pyngrok import ngrok
ngrok.set_auth_token(os.environ["NGROK_AUTH_TOKEN"])
tunnel = ngrok.connect(8000, "http", region="us")
print("Public URL:", tunnel.public_url)

# Now run uvicorn in the background. The notebook cell will run until you stop it.
import uvicorn
uvicorn.run("main_server:app", host="0.0.0.0", port=8000)
