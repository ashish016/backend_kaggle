# LLM provider (gemini | openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini

# TTS provider (edge-tts | elevenlabs)
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# Visuals (stock | diffusers | both)
VISUALS_MODE=stock
PEXELS_API_KEY=your_pexels_api_key_here
# PIXABAY_API_KEY=...
# HF_MODEL=cerspense/zeroscope_v2_576w

# Optional: path to a single background music mp3
# BACKGROUND_MUSIC_PATH=/kaggle/working/background.mp3

# Ngrok (required on Kaggle)
NGROK_AUTH_TOKEN=your_ngrok_token_here
NGROK_PORT=8000
NGROK_REGION=us  # us | eu | ap | au | sa | jp | in

# CORS — comma-separated list of allowed origins, or "*" for dev
CORS_ORIGINS=*

# YouTube upload (paths to OAuth client secret + cached token json)
YOUTUBE_PRIVACY=private  # public | unlisted | private
